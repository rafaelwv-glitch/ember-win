<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Ember.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Ember">
    <Grid x:Name="Root">
        <NavigationView
            x:Name="Nav"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.PaneHeader>
                <TextBlock Text="Ember" FontSize="22" FontWeight="SemiBold" Margin="16,14,16,8" />
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavEdit" Content="Edit" Tag="edit" />
                <NavigationViewItem x:Name="NavLibrary" Content="Library" Tag="library" />
                <NavigationViewItem x:Name="NavFire" Content="Fire" Tag="fire" />
                <NavigationViewItem x:Name="NavChecks" Content="Checks" Tag="checks" />
            </NavigationView.MenuItems>
            <Grid RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,8" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Demo catalogue. Nothing is posted." />
                    <Button Grid.Column="1" Content="Fire  F5" Click="Fire_Click" Background="{StaticResource EmberBrush}" Foreground="{StaticResource EmberInkBrush}" />
                    <Button Grid.Column="2" Content="New" Click="New_Click" />
                    <Button Grid.Column="3" Content="Reset" Click="Reset_Click" />
                    <ComboBox x:Name="BotBox" Grid.Column="4" MinWidth="220" SelectionChanged="BotBox_SelectionChanged" />
                </Grid>
                <Frame x:Name="RootFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
